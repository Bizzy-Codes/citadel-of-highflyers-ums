VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional. Live exam video connects pupil -> teacher directly, which works
# on the school network with no setup. If a teacher needs to monitor from
# outside that network, point these at a TURN relay (e.g. Metered, Twilio).
# VITE_TURN_URLS=turn:relay.example.com:3478,turns:relay.example.com:5349
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
